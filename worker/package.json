{
  "name": "@dyadryn/arena-candidate",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix engine run build && tsc -p tsconfig.json",
    "test": "npm run build && npm run bundle && node --test tests/*.test.mjs",
    "test:engine": "npm --prefix engine test",
    "simulate": "npm --prefix engine run simulate -- 10000",
    "bundle": "wrangler deploy --dry-run --outdir build",
    "check": "npm run lint && npm run test:engine && npm test",
    "lint": "eslint src engine/src",
    "dev": "npm run build && npm run bundle && node scripts/local-server.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "connector": "esbuild connector/muse-connect.ts --bundle --platform=node --format=esm --target=node20 --outfile=../src/assets/connect/muse-connect.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "5.20260930.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "esbuild": "0.28.1",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "miniflare": "^5.20260926.1-alpha",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "wrangler": "^4.0.0",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true
  }
}