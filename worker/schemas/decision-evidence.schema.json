{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dyadryn.example/schemas/decision-evidence.v1.json",
  "title": "DYADRYN DecisionEvidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "question_set_id", "state_hash", "model_route", "status", "answers"],
  "properties": {
    "schema_version": {"const": "dyadryn.jev.evidence.v1"},
    "question_set_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "state_hash": {"type": "string", "minLength": 16, "maxLength": 256},
    "model_route": {"const": "typesafe/jev"},
    "model_version": {"type": ["string", "null"], "maxLength": 128},
    "status": {"enum": ["available", "unavailable", "invalid", "budget_blocked"]},
    "answers": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "noul"],
            "properties": {
              "type": {"const": "noul"},
              "noul": {"type": "number", "minimum": 0, "maximum": 1}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "choice", "confidence", "probabilities"],
            "properties": {
              "type": {"const": "choice"},
              "choice": {"type": "string", "minLength": 1, "maxLength": 64},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "probabilities": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "score", "confidence", "probabilities"],
            "properties": {
              "type": {"const": "score"},
              "score": {"type": "number"},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "legend": {"type": "object", "additionalProperties": {"type": "string"}},
              "probabilities": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}}
            }
          }
        ]
      }
    },
    "usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0}
      }
    }
  }
}
